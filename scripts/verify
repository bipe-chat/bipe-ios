#!/bin/sh
# Fast check before a push: SwiftFormat lint (as in CI) and a build of the UnitTests scheme, app and tests.
# The pre-push hook in .bipe-hooks calls it. The unit tests themselves run only in CI ("Tests"): locally
# they take over an hour and the media suites need git-lfs files.
# Usage: scripts/verify [--all]
set -eu
cd "$(git rev-parse --show-toplevel)"
base=$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD)
if [ "${1:-}" != --all ] && [ -z "$(git diff --name-only "$base" HEAD | grep -v '\.md$' || true)" ]; then
  echo "verify: only Markdown changed since origin/main, nothing to check (scripts/verify --all forces it)"
  exit 0
fi
export PATH="$PATH:/opt/homebrew/bin"
# One heavy build at a time on the Mac, across the Bipe repos and Starlings (AGENTS.md, "Before you push").
# build-lock waits while another build holds the lock and names it. Without it (CI, another Mac) the build runs as before.
lock=$(command -v build-lock || echo "$HOME/.local/bin/build-lock")
heavy() {
  if [ -x "$lock" ]; then "$lock" "bipe-ios verify" "$@"; return; fi
  [ -n "${CI:-}" ] || echo "verify: build-lock is not installed; building without the machine lock" >&2
  "$@"
}
swiftformat --lint .
heavy xcodebuild build-for-testing -project ElementX.xcodeproj -scheme UnitTests \
  -destination 'generic/platform=iOS Simulator' CODE_SIGNING_ALLOWED=NO -quiet
echo "verify: ok"
