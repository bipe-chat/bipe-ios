#!/bin/sh
# Bipe: run scripts/verify (the fast check before CI) before a push, so CI stays green.
# Enable once per clone: git config core.hooksPath .bipe-hooks. A push that only deletes a branch skips it.
run=
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] || run=1
done
[ -n "$run" ] || exit 0
top=$(git rev-parse --show-toplevel)
# Git sets GIT_DIR and friends for hooks; verify runs git -C in sibling repos, which they would redirect.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_PREFIX
exec "$top/scripts/verify"
